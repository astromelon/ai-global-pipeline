  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/<you>/.claude/hooks/node4-approval-gate.py\"",
            "timeout": 10,
            "statusMessage": "Node 4 승인 게이트 확인"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/<you>/.ai-gate/sync_test_hook.py\"",
            "timeout": 150,
            "statusMessage": "게이트 훅 동기화 확인"
          }
        ]
      }
    ]
  }
}
