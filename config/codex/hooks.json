        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/<you>/.codex/hooks/node4-approval-gate-codex.py",
            "timeout": 10,
            "statusMessage": "Node 4 게이트 기록"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
